package com.plsql.parser.model;

import com.fasterxml.jackson.annotation.JsonInclude;
import java.util.*;

@JsonInclude(JsonInclude.Include.NON_EMPTY)
public class ExceptionHandlerInfo {
    private String exceptionName;
    private int line;
    private int lineEnd;
    private int statementsCount;
    private List<TableOperationInfo> tableOperations = new ArrayList<>();
    private List<CallInfo> calls = new ArrayList<>();
    /** DB2/MySQL-style handler kind: CONTINUE/EXIT/UNDO. Null for dialects with no such concept. */
    private String kind;
    /** Raw condition text(s) the handler is FOR (e.g. "SQLEXCEPTION", "NOT FOUND"). */
    private List<String> conditions = new ArrayList<>();
    /**
     * The enclosing handler this one is nested inside (i.e. this handler's protected block is
     * physically inside another handler's EXCEPTION section), or null if top-level on the
     * subprogram. Kept as a direct reference (not serialized) to avoid cyclic/duplicate JSON;
     * use {@link #getParentExceptionName()} for a stable, serializable identifier.
     */
    @com.fasterxml.jackson.annotation.JsonIgnore
    private ExceptionHandlerInfo parentHandler;

    public ExceptionHandlerInfo getParentHandler() { return parentHandler; }
    public void setParentHandler(ExceptionHandlerInfo parentHandler) { this.parentHandler = parentHandler; }
    /** Serializable stand-in for parentHandler: the parent's exceptionName, or null if top-level. */
    public String getParentExceptionName() { return parentHandler != null ? parentHandler.getExceptionName() : null; }

    public String getKind() { return kind; }
    public void setKind(String kind) { this.kind = kind; }
    public List<String> getConditions() { return conditions; }
    public void setConditions(List<String> conditions) { this.conditions = conditions; }

    public String getExceptionName() { return exceptionName; }
    public void setExceptionName(String exceptionName) { this.exceptionName = exceptionName; }
    public int getLine() { return line; }
    public void setLine(int line) { this.line = line; }
    public int getLineEnd() { return lineEnd; }
    public void setLineEnd(int lineEnd) { this.lineEnd = lineEnd; }
    public int getStatementsCount() { return statementsCount; }
    public void setStatementsCount(int statementsCount) { this.statementsCount = statementsCount; }
    public List<TableOperationInfo> getTableOperations() { return tableOperations; }
    public void setTableOperations(List<TableOperationInfo> tableOperations) { this.tableOperations = tableOperations; }
    public List<CallInfo> getCalls() { return calls; }
    public void setCalls(List<CallInfo> calls) { this.calls = calls; }
}
