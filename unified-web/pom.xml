<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.codeanalyzer</groupId>
        <artifactId>plsql-jar-analyzer</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>unified-web</artifactId>
    <name>Unified Analyzer - Web</name>

    <dependencies>
        <!-- JUnit 5 + assertions. Added for AnalysisPathsKeyParityTest: this module had no test
             dependency, so its src/test/java did not compile. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.codeanalyzer</groupId>
            <artifactId>analyzer-storage</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Mode 4 (entity-ingest): reuses IngestMain.storeSource(ArtifactStore, String) and
             MongoIngestService directly, in-process, from the post-analyze trigger. -->
        <dependency>
            <groupId>com.codeanalyzer</groupId>
            <artifactId>analysis-mongo-ingest</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.codeanalyzer</groupId>
            <artifactId>jar-analyzer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.codeanalyzer</groupId>
            <artifactId>plsql-analyzer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.codeanalyzer</groupId>
            <artifactId>plsql-parser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>23.3.0.23.09</version>
        </dependency>
        <!-- MySQL JDBC — Maven Central, no manual install needed -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
        </dependency>
        <!-- SQL Server JDBC — Maven Central, no manual install needed -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <version>12.6.1.jre11</version>
        </dependency>
        <!-- PostgreSQL JDBC — Maven Central, no manual install needed -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.13</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <!-- Flow analysis POC — test-data gen + MongoDB optimization -->
        <dependency>
            <groupId>com.codeanalyzer</groupId>
            <artifactId>flow-poc</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- POI provided transitively by jar-analyzer-core -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>-Xms512m -Xmx4g -XX:+UseG1GC -XX:+UseStringDeduplication</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
