package com.plsqlanalyzer.web.promptconfig;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.jaranalyzer.service.PromptTemplates;
import com.plsqlanalyzer.web.config.ConfigDirService;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.context.annotation.DependsOn;
import org.springframework.stereotype.Service;

import com.analyzer.storage.ArtifactKey;
import com.analyzer.storage.ArtifactStore;

import jakarta.annotation.PostConstruct;
import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.io.UncheckedIOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Path;
import java.util.*;

/**
 * Editable prompt configuration — DATA-folder backed (instance store), two-tier.
 *
 * <p>On startup the built-in default prompts are DUMPED into {@code <data-dir>/prompts/}
 * (seeded only if missing) and {@link PromptTemplates} is pointed there, so the running
 * app reads/uses prompts from the data folder.
 *
 * <p>Two save tiers when editing a prompt:
 * <ul>
 *   <li><b>Permanent</b> — {@link #saveTemplate} writes {@code <data-dir>/prompts/<name>.txt};
 *       becomes the prompt for ALL future analyses.</li>
 *   <li><b>Per-analysis</b> — {@link #saveAnalysis} stores a template override + context +
 *       append in {@code <data-dir>/prompt-analysis/<analysisName>.json}. The analysis name
 *       is the scoped folder id which already encodes datasource/project/env/connection, so
 *       the config is bound to that exact analysis identity and used only for it.</li>
 * </ul>
 * Global extras (append/context applied to every prompt) live in
 * {@code <data-dir>/prompt-extras.json}.
 */
@Service
@DependsOn("configDirService") // ensure our data-dir wins over ConfigDirService's config-dir wiring
public class PromptConfigService {

    private static final Logger log = LoggerFactory.getLogger(PromptConfigService.class);

    public static final List<String> KNOWN_TEMPLATES = List.of(
            // Per-dialect DB (PL/SQL family) verification prompts — editable per database
            "plsql-oracle-verification", "plsql-mysql-verification",
            "plsql-sqlserver-verification", "plsql-db2-verification",
            // Real bug, found via audit: Postgres's actual dialectSlug() output
            // ("plsql-postgres-verification") was missing from this list entirely, so it was never
            // seeded to the store and every GET/POST/reset call against it returned HTTP 400
            // "Unknown template name" — Postgres verification always ran off the classpath default
            // with no way to view/edit/reset it via the API, unlike every other dialect here.
            "plsql-postgres-verification",
            // Java prompts
            "java-mongo-analysis", "java-oracle-analysis", "java-both-analysis",
            "java-mongo-chunk-analysis", "java-oracle-chunk-analysis", "java-both-chunk-analysis",
            "java-mongo-correction", "java-oracle-correction", "java-both-correction",
            // Legacy single PL/SQL template (used by the non-parser path)
            "plsql-verification"
    );

    private final ObjectMapper mapper = new ObjectMapper();
    private final Path dataDir;
    private final ArtifactStore store;

    /** {@code prompts/} — the seeded, editable template store, relative to the data root. */
    private static final String PROMPTS_ROOT = "prompts";
    /** {@code prompt-analysis/} — per-analysis overrides, relative to the data root. */
    private static final String ANALYSIS_ROOT = "prompt-analysis";
    /** {@code prompt-extras.json} — global append/context, relative to the data root. */
    private static final String EXTRAS_FILE = "prompt-extras.json";

    /**
     * @param store required, never optional — an optional store would leave a silent filesystem
     *              fallback that keeps working locally and quietly diverges once the backend moves
     */
    public PromptConfigService(ConfigDirService configDirService, ArtifactStore store) {
        // Authoritative resolved data root (e.g. <cwd>/data), which is also the ArtifactStore root
        // (app.data-dir.base — see StorageConfig), so the keys below address the same tree.
        this.dataDir = configDirService.getDataDir().toAbsolutePath().normalize();
        this.store = store;
    }

    private InputStream openRead(ArtifactKey key) throws IOException { return store.read(key); }

    private OutputStream openWrite(ArtifactKey key) throws IOException { return store.write(key); }

    /** Dump default prompts into the store (if missing) and point PromptTemplates there. */
    @PostConstruct
    public void init() {
        // ONE listing tells us which of the ~14 templates are already seeded. The alternative is
        // an exists() per template — 14 HEADs on every boot against object storage.
        Set<ArtifactKey> present = existingTemplates();
        for (String name : KNOWN_TEMPLATES) {
            ArtifactKey key = templateKey(name);
            if (present.contains(key)) continue;
            String def = classpathDefault(name);
            if (def.isEmpty()) continue;
            try (OutputStream out = openWrite(key)) {
                out.write(def.getBytes(StandardCharsets.UTF_8));
            } catch (IOException e) {
                log.warn("Prompt seed of {} failed: {}", key, e.getMessage());
            }
        }
        pointTemplatesToDataDir();
        log.info("PromptConfigService: prompts store = {} (seeded {} templates)",
                PROMPTS_ROOT, KNOWN_TEMPLATES.size());
    }

    /** Keys of the templates that already exist in the store, in one round trip. */
    private Set<ArtifactKey> existingTemplates() {
        try {
            return store.statPrefix(ArtifactKey.of(PROMPTS_ROOT)).keySet();
        } catch (IOException e) {
            log.warn("Prompt store listing failed: {}", e.getMessage());
            return Set.of();
        }
    }

    private void pointTemplatesToDataDir() {
        // PromptTemplates reads prompts/<name>.txt from the store — the SAME keys templateKey()
        // writes below. It used to be handed a local Path instead, which meant the reader stayed on
        // disk while this writer moved to the store: indistinguishable locally, and serving stale
        // or missing prompts the instant the backend is remote. Also clears the template cache,
        // which is why every save/reset calls this.
        PromptTemplates.setTemplateStore(store);
    }

    // ==================== templates (permanent, shared store) ====================

    public boolean isKnownTemplate(String name) { return name != null && KNOWN_TEMPLATES.contains(name); }

    public List<Map<String, Object>> listTemplates() {
        pointTemplatesToDataDir();
        // ONE listing for the whole set, instead of two exists() per template inside the loop.
        Set<ArtifactKey> present = existingTemplates();
        List<Map<String, Object>> out = new ArrayList<>();
        for (String name : KNOWN_TEMPLATES) {
            ArtifactKey ext = templateKey(name);
            String defaultText = classpathDefault(name);
            String stored = present.contains(ext) ? readQuiet(ext) : null;
            boolean overridden = stored != null && !stored.equals(defaultText);
            String current = stored != null ? stored : defaultText;
            Map<String, Object> m = new LinkedHashMap<>();
            m.put("name", name);
            m.put("current", current);
            m.put("defaultText", defaultText);
            m.put("overridden", overridden);
            out.add(m);
        }
        return out;
    }

    /** Permanent save — writes into the data-folder store, used by all future analyses. */
    public void saveTemplate(String name, String text) {
        requireKnown(name);
        writeText(templateKey(name), text == null ? "" : text, "save template " + name);
        pointTemplatesToDataDir(); // clears PromptTemplates cache
    }

    /** Reset a template back to the built-in default (re-seeds the stored copy). */
    public void resetTemplate(String name) {
        requireKnown(name);
        writeText(templateKey(name), classpathDefault(name), "reset template " + name);
        pointTemplatesToDataDir();
    }

    /** Effective template text: per-analysis override → stored template → classpath default. */
    public String effectiveTemplate(String name, String analysisName) {
        if (analysisName != null && !analysisName.isBlank()) {
            Map<String, String> tmpl = analysisTemplates(analysisName);
            String o = tmpl.get(name);
            if (o != null && !o.isEmpty()) return o;
        }
        ArtifactKey ext = templateKey(name);
        if (store.exists(ext)) {
            String stored = readQuiet(ext);
            if (stored != null) return stored;
        }
        return classpathDefault(name);
    }

    /**
     * {@code prompts/<name>.txt}. No traversal guard is needed beyond this: every segment is
     * validated by {@link ArtifactKey}, which rejects {@code ..}, {@code /} and {@code \}.
     */
    private static ArtifactKey templateKey(String name) {
        // Delegated, not re-derived: PromptTemplates READS this exact key. Two independent
        // spellings of the same address is precisely how the reader and the writer drifted apart
        // before, so there is only one of them now.
        return PromptTemplates.templateKey(name);
    }

    private String classpathDefault(String name) {
        try (InputStream is = PromptConfigService.class.getClassLoader().getResourceAsStream("prompts/" + name + ".txt")) {
            if (is == null) return "";
            return new String(is.readAllBytes(), StandardCharsets.UTF_8);
        } catch (IOException e) {
            log.warn("Failed to read classpath default {}: {}", name, e.getMessage());
            return "";
        }
    }

    // ==================== global extras ====================

    public Map<String, String> getExtras() {
        Map<String, String> r = new LinkedHashMap<>();
        r.put("globalAppend", ""); r.put("globalContext", "");
        ArtifactKey f = ArtifactKey.of(EXTRAS_FILE);
        if (store.exists(f)) {
            try (InputStream in = openRead(f)) {
                Map<?, ?> raw = mapper.readValue(in, Map.class);
                r.put("globalAppend", str(raw.get("globalAppend")));
                r.put("globalContext", str(raw.get("globalContext")));
            } catch (IOException e) { log.warn("read {}: {}", f, e.getMessage()); }
        }
        return r;
    }

    public Map<String, String> saveExtras(String globalAppend, String globalContext) {
        Map<String, String> d = new LinkedHashMap<>();
        d.put("globalAppend", nz(globalAppend)); d.put("globalContext", nz(globalContext));
        writeJson(ArtifactKey.of(EXTRAS_FILE), d);
        return d;
    }

    // ==================== per-analysis (scoped, non-permanent) ====================

    /** Per-analysis config: {context, append, templates:{name:text}} bound to the scoped analysis id. */
    public Map<String, Object> getAnalysis(String name) {
        Map<String, Object> r = new LinkedHashMap<>();
        r.put("context", ""); r.put("append", ""); r.put("templates", new LinkedHashMap<String, String>());
        ArtifactKey f = analysisKey(name);
        if (store.exists(f)) {
            try (InputStream in = openRead(f)) {
                Map<?, ?> raw = mapper.readValue(in, Map.class);
                r.put("context", str(raw.get("context")));
                r.put("append", str(raw.get("append")));
                Object t = raw.get("templates");
                if (t instanceof Map<?, ?> tm) {
                    Map<String, String> mm = new LinkedHashMap<>();
                    tm.forEach((k, v) -> mm.put(String.valueOf(k), str(v)));
                    r.put("templates", mm);
                }
            } catch (IOException e) { log.warn("read {}: {}", f, e.getMessage()); }
        }
        return r;
    }

    @SuppressWarnings("unchecked")
    public Map<String, String> analysisTemplates(String name) {
        Object t = getAnalysis(name).get("templates");
        return t instanceof Map ? (Map<String, String>) t : new LinkedHashMap<>();
    }

    public Map<String, Object> saveAnalysis(String name, String context, String append, Map<String, String> templates) {
        Map<String, Object> d = new LinkedHashMap<>();
        d.put("context", nz(context));
        d.put("append", nz(append));
        Map<String, String> t = new LinkedHashMap<>();
        if (templates != null) templates.forEach((k, v) -> { if (isKnownTemplate(k)) t.put(k, nz(v)); });
        d.put("templates", t);
        writeJson(analysisKey(name), d);
        return d;
    }

    private static ArtifactKey analysisKey(String name) {
        return ArtifactKey.of(ANALYSIS_ROOT, safeName(name) + ".json");
    }

    /**
     * Sanitises a user-supplied analysis name into one safe path segment.
     *
     * <p>The old form relied on the result staying inside a base directory. Keys have no base to
     * compare against, so the traversal guard is explicit here — and {@link ArtifactKey} rejects
     * separators and {@code ..} a second time on the way in.
     */
    static String safeName(String name) {
        if (name == null || name.isBlank()) return "_";
        String c = name.trim().replaceAll("[^A-Za-z0-9._-]", "_").replaceAll("^\\.+", "_");
        while (c.contains("..")) c = c.replace("..", "_");   // no parent-directory hop, ever
        if (c.isBlank()) return "_";
        return c.length() > 200 ? c.substring(0, 200) : c;
    }

    // ==================== helpers ====================

    private void requireKnown(String name) {
        if (!isKnownTemplate(name)) throw new IllegalArgumentException("Unknown template name: " + name);
    }

    /** No createDirectories: the store creates parents on write, and close() is the commit. */
    private void writeJson(ArtifactKey key, Object data) {
        try (OutputStream out = openWrite(key)) {
            mapper.writerWithDefaultPrettyPrinter().writeValue(out, data);
        } catch (IOException e) { throw new UncheckedIOException("Failed to write " + key, e); }
    }

    private void writeText(ArtifactKey key, String text, String what) {
        try (OutputStream out = openWrite(key)) {
            out.write(text.getBytes(StandardCharsets.UTF_8));
        } catch (IOException e) {
            throw new UncheckedIOException("Failed to " + what, e);
        }
    }

    /** @return the stored text, or null when it could not be read (absent or broken) */
    private String readQuiet(ArtifactKey key) {
        try (InputStream in = openRead(key)) {
            return new String(in.readAllBytes(), StandardCharsets.UTF_8);
        } catch (IOException e) { log.warn("read {}: {}", key, e.getMessage()); return null; }
    }

    private static String str(Object o) { return o == null ? "" : o.toString(); }
    private static String nz(String s) { return s == null ? "" : s; }
}
