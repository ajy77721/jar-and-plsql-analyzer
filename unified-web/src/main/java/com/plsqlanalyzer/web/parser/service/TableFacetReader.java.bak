package com.plsqlanalyzer.web.parser.service;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ArrayNode;
import com.fasterxml.jackson.databind.node.ObjectNode;

import com.analyzer.storage.ArtifactKey;

import java.io.IOException;
import java.io.InputStream;
import java.util.*;

import static com.plsqlanalyzer.web.parser.service.StaticAnalysisReader.textOrDefault;

/** Table-facet reads: getTables (package merge). */
class TableFacetReader {

    private final StaticAnalysisReader r;

    TableFacetReader(StaticAnalysisReader r) {
        this.r = r;
    }

    /** Streams a JSON document out of the store. */
    private JsonNode readTree(ArtifactKey key) throws IOException {
        try (InputStream in = r.openRead(key)) {
            return r.mapper.readTree(in);
        }
    }

    /**
     * Just the root scalars of the tables index: {@code totalTables}, {@code totalTablesRaw},
     * {@code dbValidated}.
     *
     * <p>The topbar needs one integer, and getting it used to mean fetching the whole document —
     * 152 KB measured, ~307 KB at the largest observed, on every analysis load. This streams the
     * root object and skips the {@code tables} array entirely, so the cost no longer scales with
     * the number of tables. The full document is still served to the Table Detail screen, which
     * genuinely needs it, on demand rather than eagerly.
     */
    com.fasterxml.jackson.databind.node.ObjectNode getTablesSummary(String name) throws IOException {
        ObjectMapper mapper = r.mapper;
        com.fasterxml.jackson.databind.node.ObjectNode out = mapper.createObjectNode();
        ArtifactKey file = r.resolveKey(name, "api/tables/index.json");
        if (!r.store().exists(file)) {
            // Fall back to the merged/synthesised path, which is already cached; take the scalars
            // from it rather than reporting nothing.
            JsonNode full = getTables(name);
            if (full != null) {
                copyScalars(full, out);
                if (full.has("tables") && full.get("tables").isArray()) {
                    int visible = 0;
                    for (JsonNode t : full.get("tables")) {
                        boolean hidden = t.path("dbValidated").asBoolean(false)
                                && !t.path("dbFound").asBoolean(true);
                        if (!hidden) visible++;
                    }
                    out.put("validatedTableCount", visible);
                    if (!out.has("totalTables")) out.put("totalTables", full.get("tables").size());
                }
            }
            return out;
        }
        try (InputStream in = r.openRead(file);
             com.fasterxml.jackson.core.JsonParser parser = mapper.getFactory().createParser(in)) {
            if (parser.nextToken() != com.fasterxml.jackson.core.JsonToken.START_OBJECT) return out;
            while (parser.nextToken() != com.fasterxml.jackson.core.JsonToken.END_OBJECT) {
                String field = parser.currentName();
                com.fasterxml.jackson.core.JsonToken t = parser.nextToken();
                if ("tables".equals(field)
                        && t == com.fasterxml.jackson.core.JsonToken.START_ARRAY) {
                    // Count the array WITHOUT materialising it, applying the same predicate the
                    // client applies. The topbar has always shown the filtered count, so returning
                    // the raw `totalTables` here would silently change a displayed number — the
                    // filter drops a table only when it was validated against the database and not
                    // found (api.js getTablesIndex: dbValidated !== true || dbFound !== false).
                    out.put("validatedTableCount", countVisibleTables(parser));
                    continue;
                }
                if (t == com.fasterxml.jackson.core.JsonToken.START_ARRAY
                        || t == com.fasterxml.jackson.core.JsonToken.START_OBJECT) {
                    // The whole point: never read the big arrays into memory.
                    parser.skipChildren();
                    continue;
                }
                switch (field) {
                    case "totalTables", "totalTablesRaw" -> out.put(field, parser.getIntValue());
                    case "dbValidated" -> out.put(field, parser.getBooleanValue());
                    default -> { /* ignore every other scalar */ }
                }
            }
        }
        return out;
    }

    /**
     * Counts table entries the UI would display, streaming one element at a time.
     *
     * <p>Mirrors the client-side predicate exactly: an entry is hidden only when
     * {@code dbValidated == true && dbFound == false}. Memory stays constant regardless of how many
     * tables there are, which is the reason for doing this here rather than counting a parsed array.
     */
    private static int countVisibleTables(com.fasterxml.jackson.core.JsonParser parser)
            throws IOException {
        int visible = 0;
        while (parser.nextToken() != com.fasterxml.jackson.core.JsonToken.END_ARRAY) {
            if (parser.currentToken() != com.fasterxml.jackson.core.JsonToken.START_OBJECT) {
                parser.skipChildren();
                continue;
            }
            Boolean dbValidated = null;
            Boolean dbFound = null;
            while (parser.nextToken() != com.fasterxml.jackson.core.JsonToken.END_OBJECT) {
                String f = parser.currentName();
                com.fasterxml.jackson.core.JsonToken v = parser.nextToken();
                if (v == com.fasterxml.jackson.core.JsonToken.START_ARRAY
                        || v == com.fasterxml.jackson.core.JsonToken.START_OBJECT) {
                    parser.skipChildren();
                } else if ("dbValidated".equals(f)) {
                    dbValidated = parser.getBooleanValue();
                } else if ("dbFound".equals(f)) {
                    dbFound = parser.getBooleanValue();
                }
            }
            boolean hidden = Boolean.TRUE.equals(dbValidated) && Boolean.FALSE.equals(dbFound);
            if (!hidden) visible++;
        }
        return visible;
    }

    /**
     * One row per table with only what a list needs: {@code name}, {@code schema},
     * {@code objectType}, {@code operations} and {@code accessCount}.
     *
     * <h2>Why this exists</h2>
     *
     * <p>The left panel renders a name, a row of operation badges and a count. To get them it called
     * {@code getTableOperations()}, which flat-maps {@code usedBy[].operations} into one object per
     * access <em>line</em> — roughly a million objects at the stated target — and then discards every
     * one of them. The three fields it keeps do not need the access lines at all.
     *
     * <p>So the count is accumulated while streaming and the lines are never materialised. Memory is
     * constant in the number of access lines, and the response carries table rows rather than access
     * rows. {@code /tables} still serves the full document to the Table Detail screen, which needs it.
     *
     * <p>Applies the same visibility predicate as {@link #getTablesSummary}: a table is hidden only
     * when it was validated against the database and not found. Diverging here would make the list
     * and the count in the topbar disagree.
     */
    ObjectNode getTablesList(String name) throws IOException {
        ObjectMapper mapper = r.mapper;
        ObjectNode out = mapper.createObjectNode();
        ArrayNode rows = out.putArray("tables");

        ArtifactKey file = r.resolveKey(name, "api/tables/index.json");
        if (!r.store().exists(file)) {
            // The merged/synthesised path is already cached, so project from it rather than
            // returning nothing. Same shape out, so the caller cannot tell which path it took.
            JsonNode full = getTables(name);
            if (full != null && full.has("tables") && full.get("tables").isArray()) {
                for (JsonNode t : full.get("tables")) {
                    if (hidden(t)) continue;
                    rows.add(projectRow(mapper, t));
                }
            }
            out.put("totalTables", rows.size());
            return out;
        }

        try (InputStream in = r.openRead(file);
             com.fasterxml.jackson.core.JsonParser parser = mapper.getFactory().createParser(in)) {
            if (parser.nextToken() != com.fasterxml.jackson.core.JsonToken.START_OBJECT) return out;
            while (parser.nextToken() != com.fasterxml.jackson.core.JsonToken.END_OBJECT) {
                String field = parser.currentName();
                com.fasterxml.jackson.core.JsonToken t = parser.nextToken();
                if ("tables".equals(field)
                        && t == com.fasterxml.jackson.core.JsonToken.START_ARRAY) {
                    while (parser.nextToken() != com.fasterxml.jackson.core.JsonToken.END_ARRAY) {
                        if (parser.currentToken()
                                != com.fasterxml.jackson.core.JsonToken.START_OBJECT) {
                            parser.skipChildren();
                            continue;
                        }
                        ObjectNode row = readRow(mapper, parser);
                        if (row != null) rows.add(row);
                    }
                    continue;
                }
                if (t == com.fasterxml.jackson.core.JsonToken.START_ARRAY
                        || t == com.fasterxml.jackson.core.JsonToken.START_OBJECT) {
                    parser.skipChildren();
                    continue;
                }
                if ("totalTablesRaw".equals(field) || "totalTables".equals(field)) {
                    out.put(field, parser.getIntValue());
                }
            }
        }
        out.put("visibleTables", rows.size());
        return out;
    }

    /**
     * Reads one table element, accumulating the access count without keeping the access lines.
     *
     * @return the projected row, or null when the table is one the UI hides
     */
    private static ObjectNode readRow(ObjectMapper mapper,
                                      com.fasterxml.jackson.core.JsonParser parser)
            throws IOException {
        ObjectNode row = mapper.createObjectNode();
        ArrayNode ops = mapper.createArrayNode();
        long accessCount = 0;
        Boolean dbValidated = null;
        Boolean dbFound = null;

        while (parser.nextToken() != com.fasterxml.jackson.core.JsonToken.END_OBJECT) {
            String f = parser.currentName();
            com.fasterxml.jackson.core.JsonToken v = parser.nextToken();
            switch (f == null ? "" : f) {
                case "name", "schema", "objectType" -> {
                    if (v.isScalarValue()) row.put(f, parser.getValueAsString());
                    else parser.skipChildren();
                }
                case "allOperations" -> {
                    if (v == com.fasterxml.jackson.core.JsonToken.START_ARRAY) {
                        while (parser.nextToken()
                                != com.fasterxml.jackson.core.JsonToken.END_ARRAY) {
                            ops.add(parser.getValueAsString());
                        }
                    } else {
                        parser.skipChildren();
                    }
                }
                case "usedBy" -> accessCount = countAccessLines(parser, v);
                case "dbValidated" -> dbValidated = v.isScalarValue() ? parser.getBooleanValue() : null;
                case "dbFound" -> dbFound = v.isScalarValue() ? parser.getBooleanValue() : null;
                default -> {
                    if (v == com.fasterxml.jackson.core.JsonToken.START_ARRAY
                            || v == com.fasterxml.jackson.core.JsonToken.START_OBJECT) {
                        parser.skipChildren();
                    }
                }
            }
        }
        if (Boolean.TRUE.equals(dbValidated) && Boolean.FALSE.equals(dbFound)) return null;
        row.set("operations", ops);
        row.put("accessCount", accessCount);
        return row;
    }

    /**
     * Total access lines across {@code usedBy[].operations}, counted as the parser walks.
     *
     * <p>This is the array that made the old path expensive: one object per line, per operation, per
     * using node. Only its size is needed, so only its size is kept.
     */
    private static long countAccessLines(com.fasterxml.jackson.core.JsonParser parser,
                                         com.fasterxml.jackson.core.JsonToken start)
            throws IOException {
        if (start != com.fasterxml.jackson.core.JsonToken.START_ARRAY) {
            parser.skipChildren();
            return 0;
        }
        long total = 0;
        while (parser.nextToken() != com.fasterxml.jackson.core.JsonToken.END_ARRAY) {
            if (parser.currentToken() != com.fasterxml.jackson.core.JsonToken.START_OBJECT) {
                parser.skipChildren();
                continue;
            }
            while (parser.nextToken() != com.fasterxml.jackson.core.JsonToken.END_OBJECT) {
                String f = parser.currentName();
                com.fasterxml.jackson.core.JsonToken v = parser.nextToken();
                if (!"operations".equals(f)) {
                    if (v == com.fasterxml.jackson.core.JsonToken.START_ARRAY
                            || v == com.fasterxml.jackson.core.JsonToken.START_OBJECT) {
                        parser.skipChildren();
                    }
                    continue;
                }
                if (v != com.fasterxml.jackson.core.JsonToken.START_OBJECT) {
                    parser.skipChildren();
                    continue;
                }
                while (parser.nextToken() != com.fasterxml.jackson.core.JsonToken.END_OBJECT) {
                    com.fasterxml.jackson.core.JsonToken lines = parser.nextToken();
                    if (lines != com.fasterxml.jackson.core.JsonToken.START_ARRAY) {
                        parser.skipChildren();
                        continue;
                    }
                    while (parser.nextToken()
                            != com.fasterxml.jackson.core.JsonToken.END_ARRAY) {
                        total++;
                    }
                }
            }
        }
        return total;
    }

    /** The tree-shaped equivalent of {@link #readRow}, for the synthesised path. */
    private static ObjectNode projectRow(ObjectMapper mapper, JsonNode t) {
        ObjectNode row = mapper.createObjectNode();
        row.put("name", textOrDefault(t, "name", ""));
        row.put("schema", textOrDefault(t, "schema", ""));
        row.put("objectType", textOrDefault(t, "objectType", "TABLE"));
        ArrayNode ops = row.putArray("operations");
        if (t.has("allOperations") && t.get("allOperations").isArray()) {
            // Guard against a JSON-null array element: unguarded o.asText() would turn it into the
            // literal string "null" (same bug class as the table-name issue this file already
            // guards against above) instead of just skipping it.
            for (JsonNode o : t.get("allOperations")) if (!o.isNull()) ops.add(o.asText());
        }
        long count = 0;
        for (JsonNode u : t.path("usedBy")) {
            for (JsonNode lines : u.path("operations")) {
                if (lines.isArray()) count += lines.size();
            }
        }
        row.put("accessCount", count);
        return row;
    }

    private static boolean hidden(JsonNode t) {
        return t.path("dbValidated").asBoolean(false) && !t.path("dbFound").asBoolean(true);
    }

    private static void copyScalars(JsonNode from,
                                    com.fasterxml.jackson.databind.node.ObjectNode to) {
        for (String f : new String[]{"totalTables", "totalTablesRaw"}) {
            if (from.hasNonNull(f)) to.put(f, from.get(f).asInt());
        }
        if (from.hasNonNull("dbValidated")) to.put("dbValidated", from.get("dbValidated").asBoolean());
    }

    JsonNode getTables(String name) throws IOException {
        ObjectMapper mapper = r.mapper;
        ArtifactKey file = r.resolveKey(name, "api/tables/index.json");
        if (r.store().exists(file)) return readTree(file);

        String key = r.cacheKey(name, "tables");
        JsonNode cached = r.synthesizedCache.get(key);
        if (cached != null) return cached;

        // Package analysis: merge tables from all proc subfolders
        JsonNode index;
        try { index = r.getIndex(name); } catch (IOException e) { index = mapper.createObjectNode(); }
        if (!index.has("_packageAnalysis") || !index.get("_packageAnalysis").asBoolean()) {
            throw new IOException("tables/index.json not found: " + file);
        }

        // Key: schema.name → merged table ObjectNode
        Map<String, ObjectNode> tableMap = new LinkedHashMap<>();
        Map<String, String> opSummary = new LinkedHashMap<>();

        // subFolders() already returns the child folders sorted by name.
        List<ArtifactKey> procDirs = CoreFileReader.subFolders(r.store(), AnalysisPaths.dirKey(name));

        for (ArtifactKey procDir : procDirs) {
            ArtifactKey tablesFile = procDir.resolve("api").resolve("tables").resolve("index.json");
            if (!r.store().exists(tablesFile)) continue;
            JsonNode tablesIndex = readTree(tablesFile);

            // Accumulate operationSummary
            JsonNode opSum = tablesIndex.get("operationSummary");
            if (opSum != null && opSum.isObject()) {
                opSum.fields().forEachRemaining(e -> {
                    int prev = Integer.parseInt(opSummary.getOrDefault(e.getKey(), "0"));
                    opSummary.put(e.getKey(), String.valueOf(prev + e.getValue().asInt()));
                });
            }

            JsonNode tables = tablesIndex.get("tables");
            if (tables == null || !tables.isArray()) continue;
            for (JsonNode tbl : tables) {
                String schema = textOrDefault(tbl, "schema", "");
                String tblName = textOrDefault(tbl, "name", "");
                // Real bug, confirmed live on a genuinely fresh re-crawl (not stale data): some
                // upstream parser/flow-writer code path stores the literal STRING "null" as a
                // table's name — the classic Java `String.valueOf(nullRef)` gotcha, which returns
                // the text "null" rather than an actual null/missing value. Because every dialect's
                // reader merges tables by (schema, name) key, every occurrence across every
                // procedure that hit this bug all merged into ONE giant fake "null" table entry —
                // which is why it showed 1925 accesses (confirmed: not a real table, an artifact of
                // this merge). The real upstream fix (finding which visitor writes this) is a
                // separate, deeper trace; this keeps the symptom from being confusing/misleading in
                // the meantime by giving unresolved names their own distinct, honestly-labeled
                // bucket instead of a silently wrong "null" that looks like a real table.
                if ("null".equalsIgnoreCase(tblName.trim())) {
                    tblName = "(unresolved reference)";
                }
                String tblKey = schema.toUpperCase() + "." + tblName.toUpperCase();

                ObjectNode existing = tableMap.get(tblKey);
                if (existing == null) {
                    existing = tbl.deepCopy();
                    // Ensure usedBy is an array
                    if (!existing.has("usedBy") || !existing.get("usedBy").isArray()) {
                        existing.set("usedBy", mapper.createArrayNode());
                    }
                    tableMap.put(tblKey, existing);
                } else {
                    // Merge allOperations
                    ArrayNode existOps = (ArrayNode) existing.get("allOperations");
                    if (existOps == null) { existOps = mapper.createArrayNode(); existing.set("allOperations", existOps); }
                    JsonNode newOps = tbl.get("allOperations");
                    if (newOps != null && newOps.isArray()) {
                        Set<String> opSet = new LinkedHashSet<>();
                        existOps.forEach(o -> { if (!o.isNull()) opSet.add(o.asText()); });
                        newOps.forEach(o -> { if (!o.isNull()) opSet.add(o.asText()); });
                        existOps.removeAll();
                        opSet.forEach(existOps::add);
                    }
                    // Merge usedBy
                    ArrayNode existUsedBy = (ArrayNode) existing.get("usedBy");
                    if (existUsedBy == null) { existUsedBy = mapper.createArrayNode(); existing.set("usedBy", existUsedBy); }
                    JsonNode newUsedBy = tbl.get("usedBy");
                    if (newUsedBy != null && newUsedBy.isArray()) {
                        for (JsonNode u : newUsedBy) existUsedBy.add(u);
                    }
                }
            }
        }

        ObjectNode result = mapper.createObjectNode();
        result.put("totalTables", tableMap.size());
        ObjectNode opSumNode = mapper.createObjectNode();
        opSummary.forEach((k, v) -> opSumNode.put(k, Integer.parseInt(v)));
        result.set("operationSummary", opSumNode);
        ArrayNode tablesArray = mapper.createArrayNode();
        tableMap.values().forEach(tablesArray::add);
        result.set("tables", tablesArray);
        r.synthesizedCache.put(key, result);
        return result;
    }
}
