package com.plsqlanalyzer.web.parser.service;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ArrayNode;
import com.fasterxml.jackson.databind.node.ObjectNode;

import com.analyzer.storage.ArtifactKey;

import java.io.IOException;
import java.io.InputStream;
import java.util.List;

import static com.plsqlanalyzer.web.parser.service.StaticAnalysisReader.*;

/** Builds the package-level virtual call tree and resolves proc subfolder names. */
class PackageTreeBuilder {

    private final StaticAnalysisReader r;

    PackageTreeBuilder(StaticAnalysisReader r) {
        this.r = r;
    }

    /** Streams a JSON document out of the store. */
    private JsonNode readTree(ArtifactKey key) throws IOException {
        try (InputStream in = r.openRead(key)) {
            return r.mapper.readTree(in);
        }
    }

    /**
     * Build a virtual tree for a package: root = package, children = each proc subtree root.
     */
    JsonNode buildPackageVirtualTree(String name, JsonNode packageIndex) {
        ObjectMapper mapper = r.mapper;
        ObjectNode root = mapper.createObjectNode();
        String pkgName = textOrDefault(packageIndex, "entryPoint", name);
        String schema  = textOrDefault(packageIndex, "entrySchema", "");
        root.put("id",   pkgName.toUpperCase().replace(".", "_").replace("/", "_").replace("\\", "_"));
        root.put("name", pkgName);
        root.put("schemaName", schema);
        root.put("packageName", "");
        root.put("objectType", "PACKAGE");
        root.put("unitType", "PACKAGE");
        root.put("callType", "ROOT");
        root.put("callLineNumber", 0);
        root.put("startLine", 0); root.put("endLine", 0);
        root.put("readable", true);

        ArrayNode children = mapper.createArrayNode();
        JsonNode nodesArr = packageIndex.get("nodes");
        if (nodesArr != null && nodesArr.isArray()) {
            for (JsonNode procNode : nodesArr) {
                String subFolder = textOrNull(procNode, "subfolderName");
                String procId    = textOrNull(procNode, "nodeId");
                String procName  = textOrNull(procNode, "name");
                String procSchema = textOrDefault(procNode, "schema", schema);
                int loc = intOrDefault(procNode, "linesOfCode", 0);

                // Enrich from subfolder depth-0 node for sourceFile, lineStart, lineEnd, counts
                String srcFile = null;
                int lineStart = 0, lineEnd = 0;
                JsonNode childCounts = null;
                if (subFolder != null) {
                    try {
                        JsonNode subIdx = readTree(CoreFileReader.subKey(name, subFolder, "api/index.json"));
                        JsonNode subNodes = subIdx.get("nodes");
                        if (subNodes != null && subNodes.isArray()) {
                            for (JsonNode sn : subNodes) {
                                int d = sn.has("depth") ? sn.get("depth").asInt() : -1;
                                if (d == 0) {
                                    srcFile = textOrNull(sn, "sourceFile");
                                    lineStart = intOrDefault(sn, "lineStart", 0);
                                    lineEnd = intOrDefault(sn, "lineEnd", 0);
                                    childCounts = sn.get("counts");
                                    if (procNode.has("linesOfCode") == false || intOrDefault(procNode, "linesOfCode", 0) == 0) {
                                        loc = intOrDefault(sn, "linesOfCode", 0);
                                    }
                                    break;
                                }
                            }
                        }
                    } catch (IOException ignored) {}
                }

                ObjectNode child = mapper.createObjectNode();
                child.put("id",   procId   != null ? procId   : (subFolder != null ? subFolder : ""));
                child.put("name", procName != null ? procName : (subFolder != null ? subFolder : ""));
                child.put("schemaName", procSchema);
                child.put("packageName", pkgName);
                child.put("objectType", textOrDefault(procNode, "objectType", "PROCEDURE"));
                child.put("unitType", textOrDefault(procNode, "objectType", "PROCEDURE"));
                child.put("callType", "INTERNAL");
                child.put("callLineNumber", 0);
                child.put("startLine", lineStart);
                child.put("endLine", lineEnd);
                child.put("sourceFile", srcFile != null ? srcFile : "");
                child.put("linesOfCode", loc);
                child.put("readable", true);
                child.put("_subfolderName", subFolder != null ? subFolder : "");
                if (childCounts != null) child.set("counts", childCounts);
                child.set("children", mapper.createArrayNode());
                children.add(child);
            }
        }
        root.set("children", children);
        return root;
    }

    String resolveSubfolderName(String name, String nodeId) {
        ObjectMapper mapper = r.mapper;
        if (nodeId == null) return null;
        ArtifactKey parentDir = AnalysisPaths.dirKey(name);
        List<ArtifactKey> subs = CoreFileReader.subFolders(r.store(), parentDir);
        // Fast path: subfolder name matches nodeId directly
        for (ArtifactKey sub : subs) {
            if (sub.leaf().equals(nodeId)) return nodeId;
        }
        // Scan subdirs and match by converting their entryPoint to a safe node id
        return subs.stream()
                    .filter(d -> {
                        ArtifactKey idx = d.resolve("api").resolve("index.json");
                        if (!r.store().exists(idx)) return false;
                        try {
                            JsonNode i = readTree(idx);
                            String ep = textOrNull(i, "entryPoint");
                            if (ep == null) return false;
                            String computedId = ep.toUpperCase()
                                    .replace(".", "_").replace("/", "_").replace("\\", "_");
                            return computedId.equals(nodeId.toUpperCase());
                        } catch (IOException e) { return false; }
                    })
                    .findFirst()
                .map(ArtifactKey::leaf)
                .orElse(null);
    }
}
