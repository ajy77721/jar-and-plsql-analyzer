package com.plsqlanalyzer.web.parser.controller;

import com.analyzer.storage.ArtifactKey;
import com.analyzer.storage.ArtifactStore;
import com.plsqlanalyzer.web.parser.service.AnalysisPaths;
import com.fasterxml.jackson.core.JsonParser;
import com.fasterxml.jackson.core.JsonToken;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ArrayNode;
import com.fasterxml.jackson.databind.node.ObjectNode;
import com.plsqlanalyzer.web.parser.search.SearchQuery;
import com.plsqlanalyzer.web.parser.search.StatementIndexStream;
import com.plsqlanalyzer.web.parser.search.StatementSearcher;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import java.io.IOException;
import java.io.InputStream;
import java.util.Map;

/**
 * Cross-analysis statement search (§B13).
 *
 * <p>Answers the question this feature exists for — <i>"is there any UPDATE on this table for this
 * field in this proc"</i> — in one request, instead of opening procedures one at a time and reading
 * them. The query language is {@link SearchQuery}; the matching is {@link StatementSearcher}.
 *
 * <p>A separate controller for the same reason {@code TableDetailController} is separate: this is a
 * self-contained feature and deleting one file is a cleaner revert than unpicking methods from a
 * controller other screens depend on.
 *
 * <h2>What the response promises</h2>
 *
 * <ul>
 *   <li>{@code total} is counted over every match, never {@code rows.length}. A modal that says
 *       "42 UPDATEs" while showing a page of 50 must be counting the matches, not the page.</li>
 *   <li>{@code echo} is the query as the engine understood it, so a user can see how their text was
 *       interpreted rather than guessing why a result looks wrong.</li>
 *   <li>{@code errors} is populated for an unparseable query, and the response is a
 *       <b>400 listing the valid qualifiers</b> — never a silently empty page, which would read as
 *       "no such data" when the truth is "no such qualifier".</li>
 *   <li>{@code indexed} is false when the analysis predates the statement index. That is reported
 *       rather than answered with zero: an analysis that was never indexed has an unknown answer,
 *       not a negative one.</li>
 * </ul>
 */
@RestController
@RequestMapping("/api/parser/analyses")
public class PlsqlSearchController {

    /** Default page size, matching the 50 used across this UI. */
    private static final int DEFAULT_LIMIT = 50;
    private static final int MAX_LIMIT = 500;

    private final ArtifactStore store;
    private final ObjectMapper mapper;

    // The 24 MB memo was here — MID-007.
    //
    // It cached the parsed index because "almost all" of a 13 ms search was re-reading and
    // re-parsing the document. That reasoning was sound and the document is the problem: measured
    // at 7.0 MB on disk, it retains 24.3 MB parsed, and at the stated target of 8,000 procedures it
    // is ~1.1 GB. A one-entry cache with a TTL was the right way to hold something that should not
    // be held.
    //
    // Streaming removes the thing being cached. The search now costs a file read per request and
    // retains only the capped page, so there is nothing left to expire — and the staleness the TTL
    // was guarding against (an analysis re-run rewriting the artifact underneath) cannot happen,
    // because every request reads the current file.


    public PlsqlSearchController(ArtifactStore store, ObjectMapper mapper) {
        this.store = store;
        this.mapper = mapper;
    }

    @GetMapping("/{name}/search")
    public ResponseEntity<JsonNode> search(@PathVariable("name") String name,
                                           @RequestParam(value = "q", required = false) String q,
                                           @RequestParam(value = "limit", required = false) Integer limit)
            throws IOException {

        SearchQuery parsed = SearchQuery.parse(q);
        if (!parsed.errors().isEmpty()) {
            ObjectNode bad = mapper.createObjectNode();
            bad.put("query", parsed.raw());
            ArrayNode errs = bad.putArray("errors");
            parsed.errors().forEach(errs::add);
            ArrayNode valid = bad.putArray("validQualifiers");
            SearchQuery.QUALIFIERS.keySet().forEach(valid::add);
            bad.put("example", "op:UPDATE table:ERP_INVENTORY col:QTY_ALLOCATED proc:USP_ALLOCATE");
            return ResponseEntity.badRequest().body(bad);
        }

        ObjectNode out = mapper.createObjectNode();
        out.put("query", parsed.raw() == null ? "" : parsed.raw());
        ArrayNode echo = out.putArray("echo");
        parsed.echo().forEach(echo::add);

        ArtifactKey indexKey = AnalysisPaths.resolveKey(name, "api/statements/index.json");
        if (!store.exists(indexKey)) {
            // Distinguished from "zero matches" deliberately. This analysis was produced before the
            // statement index existed, so the honest answer is that we do not know — reporting 0
            // would state an absence we have not established.
            out.put("indexed", false);
            out.put("total", 0);
            out.putArray("rows");
            out.put("message", "This analysis has no statement index — re-run the analysis to search it.");
            return ResponseEntity.ok(out);
        }
        out.put("indexed", true);

        if (parsed.isEmpty()) {
            // An empty query is not a request for everything; returning 5,015 rows would be a
            // denial of service by accident. Note this path reads the header scalars only — it
            // must not walk the statements to answer "type something".
            out.put("total", 0);
            out.putArray("rows");
            out.put("totalStatements", headerTotal(indexKey));
            out.put("message", "Type something to search.");
            return ResponseEntity.ok(out);
        }

        int cap = limit == null ? DEFAULT_LIMIT : Math.max(1, Math.min(limit, MAX_LIMIT));
        StatementSearcher.Result r;
        int totalStatements;
        int statementsWithColumns;
        try (InputStream in = store.read(indexKey);
             StatementIndexStream rows = new StatementIndexStream(mapper, in)) {
            r = StatementSearcher.search(rows, parsed, cap);
            // Read after the walk: the scalars are captured as the stream passes them.
            totalStatements = rows.totalStatements();
            statementsWithColumns = rows.statementsWithColumns();
        }

        out.put("total", r.total());                 // every match, not the page
        out.put("returned", r.hits().size());
        out.put("limit", cap);
        out.put("truncated", r.total() > r.hits().size());
        out.put("totalStatements", totalStatements);
        // How much of this analysis carries column attribution at all. Without it a col: query that
        // finds nothing is ambiguous between "not written there" and "columns were never captured".
        out.put("statementsWithColumns", statementsWithColumns);
        // MID-008 (§117) — StatementSearcher.DEFAULT_MAX_SCANNED's own safety rail. When true,
        // `total`/`facets` above are honest counts of what was scanned before the cutoff, not of
        // the whole analysis — said explicitly rather than presenting a partial count as complete.
        out.put("scanLimitReached", r.scanLimitReached());

        ArrayNode rows = out.putArray("rows");
        for (StatementSearcher.Hit h : r.hits()) {
            ObjectNode row = h.row().deepCopy();
            if (!h.matchedColumns().isEmpty()) {
                ArrayNode mc = row.putArray("matchedColumns");
                h.matchedColumns().forEach(mc::add);
            }
            rows.add(row);
        }

        ObjectNode facets = out.putObject("facets");
        for (Map.Entry<String, Map<String, Integer>> f : r.facets().entrySet()) {
            ObjectNode g = facets.putObject(f.getKey());
            f.getValue().forEach(g::put);
        }
        return ResponseEntity.ok(out);
    }

    /** Counts and facets without the rows, for a topbar hint before the modal is opened. */
    @GetMapping("/{name}/search/summary")
    public ResponseEntity<JsonNode> summary(@PathVariable("name") String name,
                                            @RequestParam(value = "q", required = false) String q)
            throws IOException {
        return search(name, q, 0 + 1);   // one row keeps the shape identical; the total is the point
    }

    /**
     * The header scalars only, without walking the statements.
     *
     * <p>For the empty-query path, which needs {@code totalStatements} to tell the user how much
     * there is to search and nothing else. Streaming the rows to answer that would read the whole
     * file on every keystroke that clears the box.
     */
    private int headerTotal(ArtifactKey key) throws IOException {
        try (InputStream in = store.read(key);
             JsonParser p = mapper.getFactory().createParser(in)) {
            while (p.nextToken() != null) {
                if (p.currentToken() == JsonToken.FIELD_NAME
                        && "totalStatements".equals(p.currentName())) {
                    p.nextToken();
                    return p.getIntValue();
                }
                if (p.currentToken() == JsonToken.FIELD_NAME
                        && "statements".equals(p.currentName())) {
                    // Reached the rows without finding the scalar: stop rather than parse them.
                    return 0;
                }
            }
        }
        return 0;
    }

}
