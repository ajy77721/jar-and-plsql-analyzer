.ct-toolbar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 4px 24px 4px; min-height: 30px; gap: 6px;
}
.ct-actions { display: flex; align-items: center; gap: 4px; }

/* Hierarchy/Trace merge: Tree vs Flat layout toggle, plus the per-mode control groups shown
   beside it. Visually the same tab-button convention refs.js uses for Calls/Called By
   (css/refs.css's .refs-tabs/.refs-tab), but under its own class name — refs.js's switchTab()
   does a document-wide `.refs-tab` query on every click, and sharing the class would make
   switching References tabs blindly clear this toggle's active state too. */
.mode-tabs { display: flex; gap: 4px; }
.mode-tab {
    padding: 5px 12px; border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--bg-card); cursor: pointer; font-size: 11px;
    font-weight: 600; color: var(--text-muted); transition: all var(--transition);
}
.mode-tab:hover { border-color: var(--accent); color: var(--accent); }
.mode-tab.active { background: var(--accent); color: var(--text-inverse); border-color: var(--accent); }

.ct-mode-controls { display: flex; align-items: center; gap: 4px; }

.breadcrumb {
    display: flex; align-items: center; gap: 0; font-size: 12px;
    flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
    padding: 0 8px; color: var(--text-muted);
}
.bc-item { color: var(--text-muted); cursor: pointer; padding: 2px 4px; border-radius: var(--radius-sm); font-size: 12px; }
.bc-item:hover { color: var(--accent); background: var(--bg-hover); }
.bc-sep { color: var(--text-muted); margin: 0 2px; opacity: 0.5; }
.bc-item.bc-current { color: var(--text); font-weight: 600; cursor: default; }
.bc-item.bc-current:hover { background: none; color: var(--text); }

.ct-container {
    flex: 1; overflow: auto; padding: 4px 12px;
    background: var(--bg-card); margin: 0 24px 8px;
    border-radius: var(--radius-md); border: 1px solid var(--border);
}

.ct-row {
    display: flex; align-items: center; padding: 4px 12px 4px 0;
    font-size: 12px; cursor: pointer; min-height: 28px; line-height: 20px;
    border-radius: var(--radius); transition: background var(--transition);
}
.ct-row:hover { background: var(--bg-hover); }
.ct-row.active { background: var(--bg-hover); }

.ct-indent { flex-shrink: 0; }
.ct-depth-badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: 20px; min-width: 20px; font-size: 9px; font-weight: 700;
    color: var(--badge-gray); background: var(--badge-gray-bg); border-radius: var(--radius-sm);
    margin-right: 4px; flex-shrink: 0;
}
.ct-step {
    width: 30px; min-width: 30px; text-align: right; padding-right: 8px;
    font-weight: 700; font-size: 11px; color: var(--text-muted);
}
.ct-schema-badge {
    display: inline-block; font-size: 9px; padding: 1px 6px;
    border-radius: var(--radius-sm); font-weight: 700; margin-right: 6px; flex-shrink: 0;
}
.ct-name {
    font-family: var(--font-mono); font-weight: 600; font-size: 12px;
    color: var(--text); word-break: break-all;
}
.ct-name:hover { color: var(--accent); text-decoration: underline; }
.ct-line {
    font-size: 10px; color: var(--teal); margin-left: 8px;
    cursor: pointer; flex-shrink: 0; font-family: var(--font-mono);
}
.ct-line:hover { text-decoration: underline; color: var(--accent); }
.ct-call-line {
    font-size: 9px; color: var(--orange); margin-left: 4px;
    cursor: pointer; flex-shrink: 0; font-family: var(--font-mono);
    opacity: 0.8;
}
.ct-call-line:hover { text-decoration: underline; opacity: 1; }

.ct-call-badge {
    display: inline-block; font-size: 9px; padding: 1px 6px;
    border-radius: var(--radius-sm); margin-left: 6px; flex-shrink: 0; font-weight: 700;
}
.ct-call-badge.INTERNAL { background: var(--badge-green-bg); color: var(--badge-green); }
.ct-call-badge.EXTERNAL { background: var(--badge-red-bg); color: var(--badge-red); }
.ct-call-badge.TRIGGER { background: var(--badge-orange-bg); color: var(--badge-orange); }
.ct-call-badge.DYNAMIC { background: var(--badge-purple-bg); color: var(--badge-purple); }
.ct-call-badge.CIRCULAR { background: var(--badge-red-bg); color: var(--badge-red); }

.ct-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 16px; min-width: 16px; text-align: center;
    color: var(--text-muted); cursor: pointer; font-size: 10px;
    flex-shrink: 0; transition: transform 0.2s;
}
.ct-toggle:hover { color: var(--accent); }
.ct-children { border-left: 1px solid var(--border); margin-left: 8px; padding-left: 4px; }

.ct-lock { font-size: 10px; margin-right: 4px; flex-shrink: 0; opacity: 0.6; }

.ct-search-hit { background: var(--badge-yellow-bg) !important; border-left: 3px solid var(--orange); }

.ct-loc-badge {
    font-size: 9px; color: var(--text-muted); margin-left: 6px;
    font-family: var(--font-mono); flex-shrink: 0;
}
/* Complexity risk badge on a tree row — solid, legible H/M/L pill (white on color) */
.ct-cx-badge {
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 9px; font-weight: 800; min-width: 15px; height: 15px; padding: 1px 6px;
    border-radius: var(--radius-md); margin-left: 5px; flex-shrink: 0; letter-spacing: 0.3px; color: var(--text-inverse);
}
.ct-cx-badge.high { background: var(--red); color: var(--text-inverse); }
.ct-cx-badge.medium { background: var(--orange); color: var(--text-inverse); }
.ct-cx-badge.low { background: var(--green); color: var(--text-inverse); }

/* Trace view: repeated-call count badge (Unique mode) */
.trace-count-badge {
    margin-left: 6px; padding: 1px 6px; border-radius: var(--radius-md); font-size: 9px; font-weight: 800;
    background: var(--badge-blue-bg); color: var(--badge-blue);
}

/* The Hierarchy collapsed-row count badge is the same affordance, and clickable */
.ct-dup-badge { cursor: pointer; }

/* Call-site line chips revealed by clicking a Hierarchy ×N badge */
.ct-callsites {
    display: flex; flex-wrap: wrap; align-items: center; gap: 3px;
    padding: 3px 0 5px 0; font-size: 10px;
}
.ct-callsites-label { color: var(--text-muted); margin-right: 4px; }

/* Active state for the Trace "Unique" toggle so it's obvious when applied */
#ctUniqueBtn.active,
#traceUniqueBtn.active {
    background: var(--accent) !important; color: var(--text-inverse) !important; border-color: var(--accent) !important;
}

/* A branch the server cut rather than expand.
   Styled alongside CIRCULAR because it means the same class of thing to a reader: this row is not
   the whole story. Without a rule it would render as unstyled text — the mistake that made the
   Access Details pager collapse onto itself. */
.ct-call-badge.TRUNCATED {
    background: var(--badge-orange-bg, rgba(208, 135, 0, .15));
    color: var(--badge-orange, #d08700);
    border: 1px solid var(--badge-orange, #d08700);
    font-weight: 600;
}
