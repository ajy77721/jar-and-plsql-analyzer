package com.plsqlanalyzer.web.config;

import com.analyzer.storage.AnalysisRepository;
import com.analyzer.storage.ArtifactKey;
import com.analyzer.storage.ArtifactStore;
import com.analyzer.storage.CredentialGuardStore;
import com.analyzer.storage.InMemoryArtifactStore;
import com.analyzer.storage.LocalArtifactStore;
import com.analyzer.storage.mongo.MongoAnalysisRepository;
import com.analyzer.storage.mongo.MongoArtifactStore;
import com.analyzer.storage.repo.AnalysisQuery;
import com.analyzer.storage.repo.AnalysisRef;
import com.analyzer.storage.repo.RowStream;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.mongodb.ConnectionString;
import com.mongodb.MongoClientSettings;
import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoClients;
import com.mongodb.client.MongoDatabase;
import org.bson.Document;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.io.TempDir;
import org.springframework.scheduling.annotation.Scheduled;

import java.io.IOException;
import java.io.OutputStream;
import java.lang.reflect.Method;
import java.nio.file.Path;
import java.util.Collections;
import java.util.List;
import java.util.NoSuchElementException;
import java.util.concurrent.TimeUnit;
import java.util.function.Function;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

/**
 * The wiring gap: three garbage collectors existed and nothing ever called them.
 *
 * <p>Two halves are tested here, and only the second needs a MongoDB.
 *
 * <ol>
 *   <li><b>That it is scheduled at all.</b> Asserted on the annotation, because that is the entire
 *       content of the bug — the methods worked, they were simply never invoked, and no behavioural
 *       test can distinguish "runs every 15 minutes" from "runs never" inside a unit test's
 *       lifetime.</li>
 *   <li><b>That a pass actually reclaims space</b>, against a real server.</li>
 * </ol>
 */
class MongoHousekeepingServiceTest {

    @TempDir Path tmp;

    // ── scheduling and configuration ─────────────────────────────────────────

    @Test
    @DisplayName("sweep() is @Scheduled with a configurable interval and a delayed first pass")
    void theSweepIsActuallyScheduled() throws Exception {
        Method sweep = MongoHousekeepingService.class.getMethod("sweep");
        Scheduled scheduled = sweep.getAnnotation(Scheduled.class);
        assertNotNull(scheduled, "the sweep is not scheduled — which was the whole bug");
        assertTrue(scheduled.fixedDelayString().contains("app.storage.mongodb.sweep.interval-ms"),
                "the interval must be configurable: " + scheduled.fixedDelayString());
        // fixedDelay, not fixedRate: a sweep that overruns its interval must not have another
        // started on top of it, which for a full chunks scan is a real possibility.
        assertEquals("", scheduled.fixedRateString());
        assertFalse(scheduled.initialDelayString().isEmpty(),
                "the first pass must not race application startup");
    }

    @Test
    @DisplayName("a non-positive minimum age is refused at construction")
    void aZeroAgeThresholdIsRefused() {
        // The one setting where a typo destroys data: with no minimum age the sweeper cannot tell a
        // write in progress from an abandoned one, and the failure would appear hours later as a
        // random ingest error. Turning sweeping off is a different property.
        ArtifactStore store = new CredentialGuardStore(new InMemoryArtifactStore());
        IllegalArgumentException e = assertThrows(IllegalArgumentException.class,
                () -> new MongoHousekeepingService(store, new NoopRepository(), 0));
        assertTrue(e.getMessage().contains("sweep.enabled=false"), e.getMessage());
        assertThrows(IllegalArgumentException.class,
                () -> new MongoHousekeepingService(store, new NoopRepository(), -1));
    }

    @Test
    @DisplayName("outside mongodb mode there is nothing to sweep and the pass is a no-op")
    void inactiveWhenMongoIsNotInUse() {
        MongoHousekeepingService svc = new MongoHousekeepingService(
                new CredentialGuardStore(new InMemoryArtifactStore()), new NoopRepository(),
                MongoHousekeepingService.DEFAULT_MIN_AGE_MS);
        assertFalse(svc.active());
        assertEquals(0, svc.run());
    }

    @Test
    @DisplayName("the mongo backend is found THROUGH the credential guard, which stays wrapped")
    void theBackendIsFoundThroughTheGuard() {
        // StorageFactory.create always wraps (C4), so a sweeper that only recognised a bare
        // MongoArtifactStore would be silently inactive in every real deployment — the exact shape
        // of bug this whole exercise is about.
        try (MongoClient dead = MongoClients.create(MongoClientSettings.builder()
                .applyConnectionString(new ConnectionString("mongodb://127.0.0.1:1"))
                .applyToClusterSettings(b -> b.serverSelectionTimeout(1, TimeUnit.SECONDS))
                .build())) {
            ArtifactStore wrapped = new CredentialGuardStore(
                    new MongoArtifactStore(dead.getDatabase("nope"), "data"));
            MongoHousekeepingService svc = new MongoHousekeepingService(
                    wrapped, new NoopRepository(), MongoHousekeepingService.DEFAULT_MIN_AGE_MS);
            assertTrue(svc.active(), "the sweeper did not see the Mongo backend behind the guard");

            // …and with the server unreachable the pass reports zero rather than throwing. Never
            // let housekeeping break the application.
            assertEquals(0, svc.run());
        }
    }

    // ── it actually reclaims space ───────────────────────────────────────────

    @Test
    @DisplayName("one pass reclaims orphaned GridFS chunks, an abandoned run, and its overflow blob")
    void onePassReclaimsAllThreeClasses() throws Exception {
        MongoClient client = mongoOrSkip();
        String dbName = "analyzer_gap_test_hk_" + Long.toString(System.nanoTime(), 36);
        MongoDatabase db = client.getDatabase(dbName);
        try {
            String collection = "artifacts";
            MongoArtifactStore mongoStore =
                    new MongoArtifactStore(db, "data", 1024, collection, 100_000L);
            mongoStore.ensureIndexes();
            ArtifactStore blobs = new CredentialGuardStore(new LocalArtifactStore(tmp));
            ObjectMapper mapper = new ObjectMapper();
            OversizedSource source = new OversizedSource();
            MongoAnalysisRepository repo = new MongoAnalysisRepository(
                    db, mapper, source,
                    new com.analyzer.storage.mongo.MongoDocumentGuard(blobs, 256));
            repo.ensureIndexes();

            // 1. An abandoned large upload: chunks, no .files document.
            OutputStream abandoned = mongoStore.write(ArtifactKey.of("orphan.bin"));
            abandoned.write(new byte[512 * 1024]);
            abandoned.flush();

            // 2. An abandoned ingest: an IN_PROGRESS run with rows, and a diverted payload.
            try (RowStream s = repo.rows(
                    AnalysisQuery.ofJar(AnalysisQuery.Dataset.JAR_BUNDLED_JARS, "hk", null), null)) {
                s.next();
            }
            db.getCollection("analysis_row").insertOne(
                    new Document("runId", "gone").append("seq", 0L).append("json", "{}"));

            long chunksBefore = db.getCollection(collection + "_fs.chunks").countDocuments();
            assertTrue(chunksBefore > 0);
            assertTrue(blobCount(blobs) > 0);

            // A threshold of zero is not allowed through the constructor, so the pass is driven with
            // the smallest legal one and a moment's wait — the same code path the scheduler runs.
            Thread.sleep(1_100);
            MongoHousekeepingService svc = new MongoHousekeepingService(
                    new CredentialGuardStore(mongoStore), repo, 1_000);
            assertTrue(svc.active());
            int reclaimed = svc.run();

            assertTrue(reclaimed >= 3, "expected all three classes to be collected, got " + reclaimed);
            assertEquals(0, db.getCollection(collection + "_fs.chunks").countDocuments(),
                    "the orphaned GridFS chunks were not collected");
            assertEquals(0, db.getCollection("analysis_run").countDocuments());
            assertEquals(0, db.getCollection("analysis_row").countDocuments());
            assertEquals(0, blobCount(blobs), "the unreferenced overflow payload was not collected");
            // Idempotent: a second pass finds nothing and does not fail.
            assertEquals(0, svc.run());
        } finally {
            try {
                db.drop();
            } catch (RuntimeException ignored) {
                // best effort
            }
            client.close();
        }
    }

    private static long blobCount(ArtifactStore blobs) throws IOException {
        try (var s = blobs.list(ArtifactKey.of("repo-overflow"), true)) {
            return s.filter(e -> !e.directory()).count();
        }
    }

    private static MongoClient mongoOrSkip() {
        MongoClient c = null;
        try {
            c = MongoClients.create(MongoClientSettings.builder()
                    .applyConnectionString(new ConnectionString(
                            System.getProperty("test.mongodb.uri", "mongodb://localhost:27017")))
                    .applyToClusterSettings(b -> b.serverSelectionTimeout(2, TimeUnit.SECONDS))
                    .build());
            c.getDatabase("admin").runCommand(new Document("ping", 1));
            return c;
        } catch (RuntimeException e) {
            if (c != null) {
                try {
                    c.close();
                } catch (RuntimeException ignored) {
                    // best effort
                }
            }
            org.junit.jupiter.api.Assumptions.assumeTrue(false, "No MongoDB — skipping: " + e.getMessage());
            throw new AssertionError("unreachable");
        }
    }

    /** The scan repository's stand-in: not a Mongo repository, so nothing to sweep. */
    private static final class NoopRepository implements AnalysisRepository {
        @Override public boolean indexed() { return false; }
        @Override public List<AnalysisRef> analyses(AnalysisQuery.Dataset dataset) {
            return Collections.emptyList();
        }
        @Override public boolean exists(AnalysisQuery query) { return false; }
        @Override public JsonNode document(AnalysisQuery query) { return null; }
        @Override public RowStream rows(AnalysisQuery q, Function<JsonNode, JsonNode> p) {
            return new RowStream() {
                @Override public boolean hasNext() { return false; }
                @Override public JsonNode next() { throw new NoSuchElementException(); }
                @Override public void close() { }
            };
        }
    }

    /** Yields rows large enough to be diverted by a 256-byte guard limit. */
    private static final class OversizedSource implements AnalysisRepository {
        private final ObjectMapper mapper = new ObjectMapper();

        @Override public boolean indexed() { return false; }
        @Override public List<AnalysisRef> analyses(AnalysisQuery.Dataset dataset) {
            return Collections.emptyList();
        }
        @Override public boolean exists(AnalysisQuery query) { return true; }
        @Override public JsonNode document(AnalysisQuery query) { return null; }

        @Override public RowStream rows(AnalysisQuery q, Function<JsonNode, JsonNode> p) {
            return new RowStream() {
                int i;
                @Override public boolean hasNext() { return i < 3; }
                @Override public JsonNode next() {
                    if (i >= 3) throw new NoSuchElementException();
                    try {
                        return mapper.readTree("{\"i\":" + (i++) + ",\"pad\":\"" + "w".repeat(600) + "\"}");
                    } catch (IOException e) {
                        throw new java.io.UncheckedIOException(e);
                    }
                }
                @Override public void close() { }
            };
        }
    }
}
