<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.codeanalyzer</groupId>
    <artifactId>plsql-jar-analyzer</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Unified PL/SQL + JAR Analyzer</name>

    <modules>
        <module>analyzer-storage</module>
        <module>plsql-config</module>
        <module>dialect-common</module>
        <module>mysql-parser</module>
        <module>db2-parser</module>
        <module>postgres-parser</module>
        <module>sqlserver-parser</module>
        <module>plsql-parser</module>
        <module>plsql-analyzer-core</module>
        <module>jar-analyzer-core</module>
        <module>analysis-mongo-ingest</module>
        <module>unified-web</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <antlr4.version>4.13.1</antlr4.version>
        <jsqlparser.version>5.0</jsqlparser.version>
        <asm.version>9.7</asm.version>
        <aws.sdk.version>2.25.60</aws.sdk.version>
        <!--
            Overrides spring-boot-starter-parent 3.2.5, which manages mongodb.version at 4.11.2.
            This one property is the whole lever: the Boot BOM uses it for mongodb-driver-sync,
            mongodb-driver-core, bson AND bson-record-codec, so all four move together.

            That coherence is the point, not tidiness. Pinning only mongodb-driver-sync (which is
            all any module declares) resolved sync 5.2.1 against core 4.11.2 and bson 4.11.2 —
            two driver versions on one classpath, which the analyzer-storage pom already records
            as a RUNTIME failure rather than a build failure. It compiled; MongoClientSettings
            simply had no timeout() method, because that class comes from core.

            5.2.1 rather than 4.11.2 because CSOT (client-side operation timeout) arrived in 5.2.
            Before it there was no client-wide operation timeout, so every query had to carry its
            own maxTimeMS and QueryTimeoutGateTest existed to ratchet down the sites that did not.
            See QueryBudget for why the per-call maxTime calls had to go at the same time: under
            CSOT the server ignores maxTimeMS, so leaving them would have silently widened every
            15-second request budget to 300.
        -->
        <mongodb.version>5.2.1</mongodb.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.codeanalyzer</groupId>
                <artifactId>plsql-config</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codeanalyzer</groupId>
                <artifactId>plsql-parser</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codeanalyzer</groupId>
                <artifactId>plsql-analyzer-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.codeanalyzer</groupId>
                <artifactId>jar-analyzer-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-runtime</artifactId>
                <version>${antlr4.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.jsqlparser</groupId>
                <artifactId>jsqlparser</artifactId>
                <version>${jsqlparser.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
